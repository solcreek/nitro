# Hoisted linker required for this fixture only.
#
# Reason: this fixture lives in a workspace alongside the @solcreek/nitro
# package, which devDeps on vitest. Vitest's transitive `@vitest/mocker`
# pulls in `estree-walker@3.0.3` (ESM-only, no default export). pnpm's
# default isolated linker keeps both 2.0.2 and 3.0.3 physically in `.pnpm/`,
# and Nitro's NFT (Node File Tracer) picks up the wrong one when
# externalising — yielding a runtime `SyntaxError: ... does not provide
# an export named 'default'` from `estree-walker`.
#
# Hoisted linker forces a flat node_modules where only the override-pinned
# v2.0.2 is reachable, so NFT traces the correct one into .output. Real
# users running Nuxt in a project without vitest in the tree do NOT need
# this — their resolution is unambiguous by construction. This file is
# strictly an artifact of our test layout.
node-linker=hoisted
