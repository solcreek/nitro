{
  "name": "@solcreek/nitro",
  "version": "0.1.0",
  "description": "Nitro preset for Creek — deploys Nuxt, SolidStart, TanStack Start, Analog, and any Nitro app to Cloudflare Workers (creek) or self-hosted creekd.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./workers": {
      "types": "./dist/presets/workers/index.d.ts",
      "default": "./dist/presets/workers/index.js"
    },
    "./creekd": {
      "types": "./dist/presets/creekd/index.d.ts",
      "default": "./dist/presets/creekd/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "vitest run test/smoke",
    "test:conformance": "vitest run test/conformance",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "creek",
    "creekd",
    "nitro",
    "nuxt",
    "solid-start",
    "tanstack-start",
    "analog",
    "cloudflare-workers",
    "adapter",
    "preset"
  ],
  "author": "SolCreek",
  "license": "Apache-2.0",
  "homepage": "https://creek.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/solcreek/nitro.git"
  },
  "dependencies": {
    "@solcreek/creekd-manifest": "^0.1.0"
  },
  "peerDependencies": {
    "nitro": ">=3.0.260522-beta"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "compatx": "^0.2.0",
    "defu": "^6.1.4",
    "destr": "^2.0.5",
    "miniflare": "^4.0.0",
    "mlly": "^1.7.4",
    "nitro": "3.0.260522-beta",
    "ofetch": "^1.4.1",
    "pathe": "^2.0.3",
    "std-env": "^3.9.0",
    "typescript": "^5.8.2",
    "vitest": "^4.1.2"
  },
  "packageManager": "pnpm@10.33.0"
}
