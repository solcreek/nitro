dist
.output
.nitro
.tmp
.wrangler
.data
*.tsbuildinfo
.DS_Store

# Ignore installed dependencies, but the vendored conformance fixture has
# its own committed `@fixture/*` packages under fixture/node_modules — those
# must stay in git, so we use explicit patterns instead of a blanket rule.
/node_modules
test/smoke/**/node_modules

# Fixture node_modules: keep the vendored @fixture/* packages (they are
# upstream test data, not installed deps), ignore everything pnpm puts
# in there.
test/conformance/fixture/node_modules/*
!test/conformance/fixture/node_modules/@fixture

test/conformance/fixture/.output
test/conformance/.tmp
